# 固定项目依赖使用公共镜像，避免个人全局 registry 污染 package-lock.json
registry=https://registry.npmmirror.com
replace-registry-host=always

# 允许自由引入/升级新依赖，彻底禁用严格的 peerDependencies 检查拦路（解决 ERESOLVE 错误）
legacy-peer-deps=true

# 引入新依赖时默认使用 ^ 浮动版本号，不锁死单一固定 patch
save-prefix=^

# 如需彻底不生成与不遵循 package-lock.json，可开启下行：
# package-lock=false
